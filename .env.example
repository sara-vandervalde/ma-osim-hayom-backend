# העתיקי את הקובץ הזה לקובץ בשם .env ומלאי ערכים אמיתיים.
# את הקובץ .env לעולם לא מעלים ל־GitHub (הוא כבר מופיע ב־.gitignore).

# כתובת מסד הנתונים (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/activities?sslmode=require"

# מסד נתונים נפרד וריק לבדיקות בלבד (הבדיקות מוחקות בו את כל הנתונים!)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/activities_test?sslmode=require"

# סוד לחתימת ה־JWT – מחרוזת אקראית וארוכה (לפחות 16 תווים, מומלץ 32 ומעלה)
JWT_SECRET="change-me-to-a-long-random-secret-string"

# תוקף ה־Token (לדוגמה: 1h, 12h, 1d, 7d)
JWT_EXPIRES_IN="1d"

# כתובות האתר (React) שמותר להן לפנות לשרת, מופרדות בפסיקים. * = כולן
CORS_ORIGIN="http://localhost:5173"

# פורט מקומי (ב־Render הוא נקבע אוטומטית)
PORT=3000

# נתוני הדגמה: true = ליצור משתמשי הדגמה בכל הפעלה של השרת
SEED_ON_START="false"
# סיסמה למשתמשי ההדגמה (חובה ב־Production אם SEED_ON_START=true)
SEED_DEMO_PASSWORD=""
